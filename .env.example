# ==============================================================================
# Co-Drive Environment Configuration (.env.example)
# Copy this file to .env and adjust variables for your local or production setup.
# ==============================================================================

# ─── Server Configuration ─────────────────────────────────────────────────────
# Port and host for the HTTP API server (defaults: PORT=8080, HOST=0.0.0.0)
PORT=8080
HOST=0.0.0.0

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Standard PostgreSQL connection string. Works out of the box with:
# - Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# - Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# - Local PostgreSQL: postgres://localhost:5432/co-drive?sslmode=disable
DATABASE_URL=postgres://localhost:5432/co-drive?sslmode=disable

# ─── Email / SMTP (Email OTP Sign-In) ──────────────────────────────────────────
# Leave unset in local dev: OTP codes will be printed directly to server console logs.
# For production (Gmail, Resend, SendGrid, Postmark, AWS SES, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@co-drive.app
